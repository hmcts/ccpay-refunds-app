{
  "consumer": {
    "name": "fp_refunds"
  },
  "interactions": [
    {
      "description": "Provider receives a POST /o/token request from FP Refunds API",
      "key": "69d6d0ec",
      "pending": false,
      "providerStates": [
        {
          "name": "a token is requested"
        }
      ],
      "request": {
        "body": {
          "content": "redirect_uri=http%3A%2F%2Fwww.dummy-pact-service.com%2Fcallback&client_id=pact&grant_type=password&username=caseworkerUsername&password=caseworkerPwd&client_secret=clientSecret&scope=openid%20profile%20roles",
          "contentType": "text/plain",
          "contentTypeHint": "DEFAULT",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/x-www-form-urlencoded"
          ]
        },
        "method": "POST",
        "path": "/o/token"
      },
      "response": {
        "body": {
          "content": {
            "access_token": "eyJ0eXAiOiJKV1QiLCJ6aXAiOiJOT05FIiwia2lkI",
            "scope": "openid roles profile"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.access_token": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.scope": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for UserInfo from FP Refunds API",
      "key": "15c08ab8",
      "pending": false,
      "providerStates": [
        {
          "name": "userinfo is requested"
        }
      ],
      "request": {
        "headers": {
          "Authorization": [
            "Bearer UserAuthToken"
          ]
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Bearer UserAuthToken"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/o/userinfo"
      },
      "response": {
        "body": {
          "content": {
            "IDAM_ADMIN_USER": "idamAdminUser",
            "familyName": "Officer",
            "givenName": "Case",
            "roles": [
              "caseworker-ia-legalrep-solicitor"
            ],
            "sub": "ia-caseofficer@fake.hmcts.net",
            "uid": "1111-2222-3333-4567"
          },
          "contentType": "application/json; charset=UTF-8",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=UTF-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.IDAM_ADMIN_USER": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.familyName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.givenName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.roles": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.roles[*]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.sub": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.uid": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.20"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "idamApi_oidc"
  }
}
